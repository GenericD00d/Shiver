{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiver",
  "version": "0.1.3",
  "identifier": "com.shiver.client",
  "build": {
    "beforeDevCommand": "bun run build:bridge && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GenericD00d/Shiver/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMjI5QUYwNDlBMTVCMTAKUldRUVc2Rko4Sm9pSDlPQ3pveWxyelI0OFRlaCtyY3dHNTg0ZXdnUi92aEN3bGI4MFZpUnhGQUIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
