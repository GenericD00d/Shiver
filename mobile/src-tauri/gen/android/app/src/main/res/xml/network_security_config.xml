<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext, enforced by the platform as well as by Shiver's own https-only rule (origin
  normalisation in shiver-core). System CAs only: a user-installed CA would let one server sit in
  the middle of every other. Debug builds overlay this (src/debug/res/xml) for the http dev server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
