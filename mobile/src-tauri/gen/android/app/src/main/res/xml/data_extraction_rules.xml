<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device, on either path.

  `allowBackup="false"` covers cloud backup, but from Android 12 device-to-device transfer is a
  separate path with its own rules — and it is the one that would carry Shiver's encrypted session
  store onto another handset. Both are excluded here, wholesale, because there is nothing in this
  app's data worth restoring: the server list is a name, an address and a colour, and everything
  else is a credential.

  The Keystore key itself never leaves the device it was made on, so a copied store would be
  unreadable anyway. This is the belt to that braces — the copy should not be made at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
