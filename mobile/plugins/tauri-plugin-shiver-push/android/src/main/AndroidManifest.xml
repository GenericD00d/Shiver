<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- lets Shiver see installed distributors (Android 11+ package visibility), and nothing else -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application>
        <!-- The cold-start receiver. Exported because the distributor is another app; it acts only on
             tokens Shiver issued and, from API 34, only on broadcasts from the chosen distributor. -->
        <receiver
            android:name="com.shiver.push.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
